# Security: required for every /api route, which fails closed (503) if this is
# unset. vite.config.ts forwards it into the frontend bundle (there is no
# frontend/.env), so restart `npm run dev` or rebuild after changing it. It
# ships in the public bundle: a bot deterrent paired with the rate limit and
# the captcha, not a secret.
NETWORK_TEST_API_KEY=change-me

# Captcha. In production set the Cloudflare Turnstile pair: the site key is
# forwarded into the bundle (the widget), the secret stays here (siteverify).
# Without TURNSTILE_SECRET the token endpoint refuses unless the opt-out
# below is set, which is for local development only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
NETWORK_TEST_ALLOW_NO_CAPTCHA=false

# Regions. Either one JSON object keyed by region name (the page offers the
# keys; "global" is the default) ...
#   NETWORK_TEST_REGIONS={"global": {"space_name": "example.signalwire.com", "project_id": "...", "auth_token": "...", "echo_resource_id": "<uuid>", "video_room_resource_id": "<uuid>"}, "eu": {...}}
# ... or, for a single space, these, which become the "global" region
# (NETWORK_TEST_REGIONS wins when both are set). SPACE_NAME is the space's
# full hostname; AUTH_TOKEN is a Dashboard API token with the Voice scope (it
# lists the resources' addresses and mints guest tokens). The resource IDs are
# the UUIDs shown on each resource's page in the Dashboard, not their
# /private/... addresses: the SWML script whose main section is answer, echo,
# hangup (README, Setup), and optionally a video room, which enables the two
# video steps. A region needs at least one of the two. Every run's token is a
# guest token allowed to dial only those addresses; no subscriber is created.
SPACE_NAME=your-space.signalwire.com
PROJECT_ID=your-project-id
AUTH_TOKEN=your-auth-token
NETWORK_TEST_ECHO_RESOURCE_ID=
NETWORK_TEST_VIDEO_ROOM_RESOURCE_ID=

# Server
PORT=5001
# CORS origin of the page when it isn't served through the Vite proxy; its
# hostname also joins Vite's allowedHosts (tunneled development).
FRONTEND_URL=http://localhost:5173
# FLASK_DEBUG=True turns on the Werkzeug debugger (code execution from the
# browser) while the server listens on 0.0.0.0 -- leave it off.
FLASK_DEBUG=False
